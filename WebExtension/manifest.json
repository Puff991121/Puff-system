{
  "manifest_version": 3,
  "name": "Puff 小红书账号监测",
  "version": "0.1.1",
  "description": "采集当前登录的小红书创作后台可见数据，并保存为本地历史快照。",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://creator.xiaohongshu.com/*",
    "https://creator.rednote.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://creator.rednote.com/*"
      ],
      "js": ["src/metric-parser.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Puff 小红书账号监测",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  }
}
